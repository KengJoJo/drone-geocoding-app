# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and fill in your actual API keys

# Google Maps API Key
# Get it from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY = "your-google-maps-api-key-here"

# Typhoon ASR API Key
# Get it from: https://opentyphoon.ai/
OPENTYPHOON_API_KEY = "your-typhoon-api-key-here"

# Optional: Typhoon API Configuration
OPENTYPHOON_BASE_URL = "https://api.opentyphoon.ai/v1"
TYPHOON_MODEL = "typhoon-asr-realtime"

# Alternative naming (if needed)
OPENAI_API_KEY = "your-typhoon-api-key-here"
OPENAI_BASE_URL = "https://api.opentyphoon.ai/v1"
